app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment variables (never checked in)
.env

# Supabase export data (customer data + QR images — never commit)
supabase/export/
supabase/export-new/
supabase/export-old-psql/

# Phase audit reports
Phase1_Audit_Report.txt

# Widget Preview related
.widget_preview/

# Agent/IDE workspace metadata (may hold local paths)
.freebuff/

# Node deps for the supabase/scripts suite
scripts/node_modules/
node_modules/

# Local Wrangler state (Pages dev/deploy scratch, regenerable)
.wrangler/

# Review bundles (assembled locally for a reviewer, regenerable)
docs/review-bundle*.txt

# dart compile js side output for the drift web worker (the worker itself is
# committed; these are regenerated by the compile step in docs/plan.md §10.3)
web/drift_worker.js.map
web/drift_worker.js.deps
